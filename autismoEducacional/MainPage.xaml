<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="autismoEducacional.Views.MainPage">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
        <Label Text="Autismo Educacional"
               FontSize="28"
               HorizontalOptions="Center"
               FontAttributes="Bold"
               TextColor="#2E86C1"/>

        <Label Text="Bem-vindo ao aplicativo inclusivo!"
               FontSize="18"
               HorizontalOptions="Center"
               TextColor="Gray"/>

        <Button Text="Cadastrar Evento"
                BackgroundColor="#4CAF50"
                TextColor="White"
                FontSize="20"
                CornerRadius="10"
                HeightRequest="60"
                Clicked="OnCadastroEventoClicked"/>

        <Button Text="Agenda Inclusiva"
                BackgroundColor="#2196F3"
                TextColor="White"
                FontSize="20"
                CornerRadius="10"
                HeightRequest="60"
                Clicked="OnAgendaInclusivaClicked"/>

        <Button Text="Buscar Recursos"
                BackgroundColor="#FF9800"
                TextColor="White"
                FontSize="20"
                CornerRadius="10"
                HeightRequest="60"
                Clicked="OnBuscaProdutoClicked"/>
    </VerticalStackLayout>
</ContentPage>
