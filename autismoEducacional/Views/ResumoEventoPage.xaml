<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="autismoEducacional.Views.ResumoEventoPage"
             Title="Resumo do Evento"
             BackgroundColor="#FFFFFF">

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="18">

            <Label Text="Resumo do Cadastro" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   TextColor="#0D47A1" 
                   HorizontalOptions="Center"/>

            <Border StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="20" BackgroundColor="#F9F9F9">
                <VerticalStackLayout Spacing="14">

                    <Label Text="{Binding Nome, StringFormat='Evento: {0}'}" FontSize="20" FontAttributes="Bold" TextColor="#000000"/>
                    <BoxView HeightRequest="1" Color="#CCCCCC"/>

                    <Label Text="{Binding Local, StringFormat='Local: {0}'}" FontSize="16" TextColor="#111111"/>

                    <Label Text="{Binding DataInicio, StringFormat='Data de Início: {0:dd/MM/yyyy}'}" FontSize="16" TextColor="#111111"/>
                    <Label Text="{Binding DataTermino, StringFormat='Data de Término: {0:dd/MM/yyyy}'}" FontSize="16" TextColor="#111111"/>

                    <Label Text="{Binding DuracaoDias, StringFormat='Duração do Evento: {0} dia(s)'}" 
                           FontAttributes="Bold" 
                           TextColor="#0D47A1" 
                           FontSize="16"/>

                    <Label Text="{Binding NumeroParticipantes, StringFormat='Número de Participantes: {0}'}" FontSize="16" TextColor="#111111"/>
                    <Label Text="{Binding CustoPorParticipante, StringFormat='Custo por Participante: R$ {0:F2}'}" FontSize="16" TextColor="#111111"/>

                    <BoxView HeightRequest="2" Color="#0D47A1"/>

                    <HorizontalStackLayout Spacing="5">
                        <Label Text="VALOR TOTAL DO EVENTO:" FontSize="18" FontAttributes="Bold" TextColor="#000000"/>
                        <Label Text="{Binding CustoTotal, StringFormat='R$ {0:F2}'}" 
                               FontSize="18" 
                               FontAttributes="Bold" 
                               TextColor="#D32F2F"/>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>

            <Button Text="Voltar e Editar" 
                    Clicked="OnVoltarClicked" 
                    BackgroundColor="#666666" 
                    TextColor="White"
                    FontAttributes="Bold"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>