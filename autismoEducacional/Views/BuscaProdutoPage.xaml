<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="autismoEducacional.Views.BuscaProdutoPage">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Buscar Recursos Educacionais"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="#2E86C1"
               HorizontalOptions="Center"/>

        <SearchBar Placeholder="Digite para buscar..."
                   TextChanged="OnSearchTextChanged"
                   PlaceholderColor="Gray"
                   TextColor="Black"/>

        <ListView ItemsSource="{Binding ProdutosFiltrados}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding Nome}"
                              Detail="{Binding Preco, StringFormat='R$ {0:F2}'}"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout>
</ContentPage>
